{% extends 'base.html.twig' %}

{% block title %}Liste des articles{% endblock %}

{% block body %}
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>📰 Articles</h1>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('app_article_nouveau') }}" class="btn btn-primary">➕ Nouvel article</a>
        {% endif %}
    </div>

    {% if articles is empty %}
        <div class="alert alert-info">
            Aucun article en base de données.
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_article_nouveau') }}" class="alert-link">Créer un article</a>
            {% endif %}
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark text-center">
                    <tr>
                        <th>ID</th>
                        <th>Titre</th>
                        <th>Auteur</th>
                        <th>Catégorie</th>
                        <th>Date</th>
                        <th>Statut</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for article in articles %}
                        <tr>
                            <td class="text-center">{{ article.id }}</td>
                            <td>{{ article.titre }}</td>
                            <td>
                                {% if article.auteurUser %}
                                    👤 {{ article.auteurUser.pseudo }}
                                {% else %}
                                    {{ article.auteur }}
                                {% endif %}
                            </td>
                            <td>{{ article.categorie ? article.categorie.nom : '—' }}</td>
                            <td>{{ article.dateCreation|date('d/m/Y') }}</td>
                            <td class="text-center">
                                {% if article.publie %}
                                    <span class="badge bg-success">✅ Publié</span>
                                {% else %}
                                    <span class="badge bg-warning text-dark">📝 Brouillon</span>
                                {% endif %}
                            </td>
                            <td class="text-center text-nowrap">
                                <a href="{{ path('app_article_detail', {id: article.id}) }}" class="btn btn-outline-primary btn-sm">👁️ Voir</a>

                                {% if app.user and (article.auteurUser == app.user or is_granted('ROLE_ADMIN')) %}
                                    <a href="{{ path('app_article_modifier', {id: article.id}) }}" class="btn btn-outline-secondary btn-sm">✏️ Modifier</a>
                                {% endif %}
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <p class="mt-3 text-muted">{{ articles|length }} article(s) en base de données</p>
    {% endif %}
{% endblock %}
